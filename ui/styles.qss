/* gohome - 퇴근길 교통정보 */

QWidget {
    font-family: "Malgun Gothic", "맑은 고딕", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #1F2933;
}

#root { background: #F3F5F8; }

/* ---------- 상단 ---------- */
#appTitle { font-size: 18pt; font-weight: 800; color: #111827; }
#lastQuery { font-size: 10pt; color: #6B7280; }
#mockBanner {
    background: #FFF4E5; color: #B45309; border: 1px solid #F59E0B;
    border-radius: 10px; padding: 3px 10px; font-weight: 700;
}
#notice {
    background: #FEF2F2; color: #B91C1C; border: 1px solid #FCA5A5;
    border-radius: 10px; padding: 8px 12px;
}

#busy { border: none; background: transparent; max-height: 3px; }
#busy::chunk { background: #2563EB; }

/* ---------- 카드 공통 ---------- */
#busCard, #subwayCard {
    background: #FFFFFF; border: 1px solid #E3E8EF; border-radius: 16px;
}
#busHeader { background: #ECF8F0; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom: 1px solid #D3EEDC; }
#subwayHeader { background: #EAF1FB; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom: 1px solid #D2E1F5; }

#cardTitle { font-size: 14pt; font-weight: 800; color: #111827; background: transparent; }
#cardSubtitle { font-size: 9.5pt; color: #4B5563; background: transparent; }
#cardFooter { font-size: 9pt; color: #6B7280; }
#cardWarning { font-size: 9pt; color: #B45309; }
#cardError {
    font-size: 10.5pt; color: #B91C1C; background: #FEF2F2;
    border: 1px solid #FECACA; border-radius: 10px; padding: 12px;
}
#placeholder { font-size: 10.5pt; color: #9CA3AF; }

#busRouteBadge {
    background: #2E9E4F; color: white; border-radius: 8px;
    padding: 4px 10px; font-size: 12pt; font-weight: 800;
}
#line1Badge {
    background: #0052A4; color: white; border-radius: 8px;
    padding: 4px 10px; font-size: 12pt; font-weight: 800;
}
#mockTag {
    background: #F59E0B; color: white; border-radius: 6px; padding: 2px 8px;
    font-size: 8.5pt; font-weight: 700;
}

/* ---------- 버스 행 ---------- */
#busRow { background: #F7FBF8; border: 1px solid #DCEFE2; border-radius: 12px; }
#rowCaption { font-size: 10pt; color: #2E7D46; font-weight: 700; background: transparent; }
#busTime { font-size: 24pt; font-weight: 800; color: #14532D; background: transparent; }
#busTimeMuted { font-size: 16pt; font-weight: 700; color: #6B7280; background: transparent; }
#rowDetail { font-size: 9.5pt; color: #4B5563; background: transparent; }

/* ---------- 지하철 표 ---------- */
#tableHead { font-size: 9pt; color: #6B7280; font-weight: 700; }
#subwayRow { background: #FFFFFF; border-bottom: 1px solid #EEF1F5; }
#destName { font-size: 11.5pt; font-weight: 700; color: #111827; }
#subwayTime { font-size: 16pt; font-weight: 800; color: #0B3D91; }
#subwayTimeMuted { font-size: 11pt; font-weight: 700; color: #4B5563; }
#etaText { font-size: 9.5pt; color: #6B7280; }
#statusText { font-size: 9.5pt; color: #374151; }

QLabel[badge="일반"] {
    background: #E6EEF9; color: #0052A4; border: 1px solid #B8CDEB;
    border-radius: 8px; padding: 2px 0px; font-weight: 700;
}
QLabel[badge="급행"] {
    background: #E5484D; color: white; border: 1px solid #E5484D;
    border-radius: 8px; padding: 2px 0px; font-weight: 700;
}
QLabel[badge="기타"] {
    background: #F3F4F6; color: #374151; border: 1px solid #D1D5DB;
    border-radius: 8px; padding: 2px 0px; font-weight: 700;
}
QLabel[tag="warn"] {
    background: #FFF4E5; color: #B45309; border-radius: 6px; padding: 1px 6px; font-size: 8.5pt;
}
QLabel[tag="ok"] {
    background: #E7F6EC; color: #15803D; border-radius: 6px; padding: 1px 6px; font-size: 8.5pt; font-weight: 700;
}
QLabel[tag="no"] {
    background: #F3F4F6; color: #9CA3AF; border-radius: 6px; padding: 1px 6px; font-size: 8.5pt;
}
QLabel[tag="info"] {
    background: #EEF2F7; color: #374151; border-radius: 6px; padding: 1px 6px; font-size: 8.5pt;
}

QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { width: 8px; background: transparent; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
